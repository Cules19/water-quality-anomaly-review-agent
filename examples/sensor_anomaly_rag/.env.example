# Save a local copy as .env in this example directory. Shell variables take precedence.
SENSOR_LLM_BASE_URL=https://api.deepseek.com
SENSOR_LLM_MODEL=deepseek-flash
# Leave blank to use DEEPSEEK_API_KEY from the shell for this endpoint.
SENSOR_LLM_API_KEY=
SENSOR_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Optional. By default the application uses the current user's local cache.
SENSOR_INDEX_DIR=
